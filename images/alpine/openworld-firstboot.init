#!/sbin/openrc-run
# Openworld first-boot provisioning: same seed-disk mechanism as the systemd
# images, driven by OpenRC. Runs in the default runlevel before dropbear.
description="Openworld first-boot provisioning from seed disk"

depend() {
    need localmount
    before dropbear
}

start() {
    ebegin "Openworld seed provisioning"
    /usr/local/sbin/openworld-firstboot.sh
    eend $? "openworld seed provisioning done (or no seed disk found)"
}